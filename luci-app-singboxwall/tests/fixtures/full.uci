config global 'global'
	option enabled '1'
	option log_level 'debug'
	option sing_box_bin '/usr/bin/sing-box'
	option temp_dir '/tmp/singboxwall-test'
	option data_dir '/tmp/singboxwall-data'
	option cache_file '/tmp/singboxwall-data/cache.db'
	option clash_api_enabled '1'
	option clash_api_listen '127.0.0.1'
	option clash_api_port '9090'
	option default_group 'proxy'
	option assume_sing_box_version '1.14.0'

config inbound 'main'
	option mixed_enabled '1'
	option mixed_listen '127.0.0.1'
	option mixed_port '1080'
	option tun_enabled '1'
	option tun_interface_name 'singboxwall0'
	option tun_address '172.19.0.1/30'
	option tun_mtu '9000'
	option tun_stack 'system'
	option tun_auto_route '1'
	option tun_auto_redirect '1'
	option tun_strict_route '1'
	option dns_enabled '1'
	option dns_listen '127.0.0.1'
	option dns_port '5353'

config dns 'dns'
	option direct_dns '223.5.5.5'
	option direct_dns_port '53'
	option remote_dns 'https://1.1.1.1/dns-query'
	option strategy 'prefer_ipv4'
	option fakeip '0'
	option cache '1'
	option final 'remote-dns'

config rule_set 'private'
	option enabled '1'
	option tag 'private'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/private.json'

config rule_set 'cn'
	option enabled '1'
	option tag 'cn'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/cn.json'

config rule_set 'block'
	option enabled '1'
	option tag 'block'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/block.json'

config node 'ss1'
	option enabled '1'
	option tag 'ss1'
	option label 'SS Test'
	option protocol 'shadowsocks'
	option server '198.51.100.1'
	option server_port '8388'
	option method '2022-blake3-aes-128-gcm'
	option password '0123456789abcdef'

config group 'proxy'
	option enabled '1'
	option tag 'proxy'
	option group_type 'selector'
	list outbound 'ss1'
	list outbound 'direct'
	option default 'ss1'

config group 'auto'
	option enabled '1'
	option tag 'auto'
	option group_type 'urltest'
	list outbound 'ss1'
	list outbound 'direct'
	option url 'https://www.gstatic.com/generate_204'
	option interval '10m'
	option tolerance '50'

config acl 'phone'
	option enabled '1'
	option action 'direct'
	list source_ip_cidr '192.168.1.50/32'
	list source_mac_address '00:11:22:33:44:55'
	list source_hostname 'phone'

config rule 'block_builtin'
	option enabled '1'
	option action 'block'
	list rule_set 'block'

config rule 'private_direct'
	option enabled '1'
	option action 'direct'
	list rule_set 'private'

config rule 'cn_direct'
	option enabled '1'
	option action 'direct'
	list rule_set 'cn'

config server 'ss_server'
	option enabled '1'
	option tag 'server-ss'
	option protocol 'shadowsocks'
	option listen '127.0.0.1'
	option listen_port '18388'
	option method '2022-blake3-aes-128-gcm'
	option password '0123456789abcdef'

config backup 'backup'
	option directory '/tmp/singboxwall-backups'
	option include_cache '0'
