#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

APP='/usr/share/singboxwall/app.sh'

. /lib/functions.sh


singboxwall_enabled() {
	local enabled
	config_load singboxwall
	config_get_bool enabled global enabled 0
	[ "$enabled" = '1' ]
}

singboxwall_bin() {
	local bin
	config_load singboxwall
	config_get bin global sing_box_bin '/usr/bin/sing-box'
	printf '%s\n' "$bin"
}

singboxwall_temp_dir() {
	local dir
	config_load singboxwall
	config_get dir global temp_dir '/tmp/etc/singboxwall'
	printf '%s\n' "$dir"
}

singboxwall_work_dir() {
	local dir
	config_load singboxwall
	config_get dir global work_dir '/var/run/singboxwall'
	printf '%s\n' "$dir"
}

start_service() {
	local bin tmp run client server

	if ! singboxwall_enabled; then
		logger -t singboxwall 'service disabled by UCI'
		return 0
	fi

	bin="$(singboxwall_bin)"
	tmp="$(singboxwall_temp_dir)"
	run="$(singboxwall_work_dir)"
	client="$tmp/client.json"
	server="$tmp/server.json"

	if [ ! -x "$bin" ]; then
		logger -t singboxwall "sing-box binary not executable: $bin"
		return 1
	fi

	if [ ! -x "$APP" ]; then
		logger -t singboxwall "app entry not executable: $APP"
		return 1
	fi

	"$APP" generate || return 1
	"$bin" check -c "$client" || return 1

	procd_open_instance client
	procd_set_param command "$bin" run -c "$client" -D "$run"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/singboxwall
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -s "$server" ]; then
		"$bin" check -c "$server" || return 1
		procd_open_instance server
		procd_set_param command "$bin" run -c "$server" -D "$run"
		procd_set_param respawn 3600 5 5
		procd_set_param file /etc/config/singboxwall
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	restart
}

stop_service() {
	local tmp
	tmp="$(singboxwall_temp_dir)"
	[ -n "$tmp" ] && [ "$tmp" != '/' ] && rm -rf "$tmp"
}

service_triggers() {
	procd_add_reload_trigger singboxwall
}
