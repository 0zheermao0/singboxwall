config global 'global'
	option enabled '0'
	option log_level 'info'
	option sing_box_bin '/usr/bin/sing-box'
	option work_dir '/var/run/singboxwall'
	option temp_dir '/tmp/etc/singboxwall'
	option data_dir '/etc/singboxwall'
	option resource_dir '/usr/share/singboxwall'
	option cache_file '/etc/singboxwall/cache.db'
	option clash_api_enabled '1'
	option clash_api_listen '127.0.0.1'
	option clash_api_port '9090'
	option clash_api_secret ''
	option default_group 'proxy'

config inbound 'main'
	option mixed_enabled '1'
	option mixed_listen '127.0.0.1'
	option mixed_port '1080'
	option mixed_set_system_proxy '0'
	option tun_enabled '1'
	option tun_interface_name 'singboxwall0'
	option tun_address '172.19.0.1/30'
	option tun_mtu '9000'
	option tun_stack 'system'
	option tun_auto_route '1'
	option tun_auto_redirect '1'
	option tun_strict_route '1'
	option dns_enabled '1'
	option dns_listen '127.0.0.1'
	option dns_port '5353'

config dns 'dns'
	option direct_dns '223.5.5.5'
	option direct_dns_port '53'
	option remote_dns 'https://1.1.1.1/dns-query'
	option strategy 'prefer_ipv4'
	option fakeip '0'
	option cache '1'
	option final 'remote-dns'

config rule_set 'private'
	option enabled '1'
	option tag 'private'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/private.json'

config rule_set 'cn'
	option enabled '1'
	option tag 'cn'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/cn.json'

config rule_set 'block'
	option enabled '1'
	option tag 'block'
	option type 'local'
	option format 'source'
	option path '/usr/share/singboxwall/defaults/rules/block.json'

config group 'proxy'
	option enabled '1'
	option tag 'proxy'
	option label 'Proxy'
	option group_type 'selector'
	list outbound 'direct'
	option default 'direct'

config group 'auto'
	option enabled '0'
	option tag 'auto'
	option label 'Auto Select'
	option group_type 'urltest'
	list outbound 'direct'
	option url 'https://www.gstatic.com/generate_204'
	option interval '10m'
	option tolerance '50'

config rule 'block_builtin'
	option enabled '1'
	option label 'Built-in block rule-set'
	option action 'block'
	list rule_set 'block'

config rule 'private_direct'
	option enabled '1'
	option label 'Private networks direct'
	option action 'direct'
	list rule_set 'private'

config rule 'cn_direct'
	option enabled '1'
	option label 'CN domains and networks direct'
	option action 'direct'
	list rule_set 'cn'

config backup 'backup'
	option directory '/etc/singboxwall/backups'
	option include_cache '0'
